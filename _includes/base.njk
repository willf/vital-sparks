<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}{% if title != "Vital Sparks" %} · Vital Sparks{% endif %}</title>
  <style>
    body { font: 1.1rem/1.6 Georgia, serif; max-width: 42rem; margin: 2rem auto; padding: 0 1rem; color: #222; }
    a { color: #7a2e0e; }
    header { margin-bottom: 2rem; border-bottom: 1px solid #ccc; }
    .sub { color: #666; font-style: italic; }
    ul.essays { list-style: none; padding: 0; }
    ul.essays li { margin: 1rem 0; }
    img { max-width: 100%; }
  </style>
</head>
<body>
  <header><a href="{{ '/' | url }}"><strong>Vital Sparks</strong></a></header>
  <main>{{ content | safe }}</main>
</body>
</html>
